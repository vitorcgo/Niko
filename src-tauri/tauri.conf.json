{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Niko",
    "version":  "0.2.1",
    "identifier":  "com.niko.desktop",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5420",
                  "beforeDevCommand":  "pnpm dev",
                  "beforeBuildCommand":  "pnpm build \u0026\u0026 pnpm ponte:build"
              },
    "app":  {
                "windows":  [

                            ],
                "withGlobalTauri":  false,
                "security":  {
